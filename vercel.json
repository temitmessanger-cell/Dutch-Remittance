{
  "version": 2,
  "name": "dutch-remit",
  "buildCommand": "flutter build web --release",
  "outputDirectory": "build/web",
  "routes": [
    {
      "src": "/sw\\.js$",
      "dest": "/sw.js",
      "headers": { "Cache-Control": "no-cache, no-store, must-revalidate" }
    },
    {
      "src": "/manifest\\.json$",
      "dest": "/manifest.json",
      "headers": { "Cache-Control": "no-cache, no-store, must-revalidate" }
    },
    {
      "src": "/flutter_bootstrap\\.js$",
      "dest": "/flutter_bootstrap.js",
      "headers": { "Cache-Control": "no-cache, no-store, must-revalidate" }
    },
    {
      "src": "/index\\.html$",
      "dest": "/index.html",
      "headers": { "Cache-Control": "no-cache, no-store, must-revalidate" }
    },
    {
      "src": "/main\\.dart\\.js$",
      "dest": "/main.dart.js",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" }
    },
    {
      "src": "^/assets/(.*)$",
      "dest": "/assets/$1",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" }
    },
    {
      "src": "^/(.+\\.(?:js|wasm|woff2?|ttf))$",
      "dest": "/$1",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" }
    },
    {
      "src": "/(.*)",
      "dest": "/index.html",
      "headers": { "Cache-Control": "no-cache, no-store, must-revalidate" }
    }
  ]
}
