# ------------------------------------------------------------------
# Dutch Remit backend — environment configuration
# Copy this file to `.env` (never commit `.env`) and fill in values.
# ------------------------------------------------------------------

# Server
PORT=4000
NODE_ENV=production

# The frontend origin allowed to call this API (CORS). Your app's
# domain from the brief:
ALLOWED_ORIGIN=https://dutchremit.dubiabank.com

# --- Eversend ---
# From https://business.eversend.co/settings -> Developers
EVERSEND_BASE_URL=https://api.eversend.co/v1
EVERSEND_CLIENT_ID=your_eversend_client_id
EVERSEND_CLIENT_SECRET=your_eversend_client_secret
# Exact Origin registered for this Eversend API client, if different from ALLOWED_ORIGIN.
EVERSEND_ORIGIN=https://dutchremit.dubiabank.com
# Set after configuring a webhook in the Eversend dashboard (Settings -> Developers -> Webhook)
EVERSEND_WEBHOOK_SECRET=your_eversend_webhook_secret

# --- Supabase ---
SUPABASE_URL=https://your-project-ref.supabase.co
# service_role key — server-side only, NEVER expose to the Flutter app
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# anon key — safe to also keep here for reference / shared config endpoints
SUPABASE_ANON_KEY=your_supabase_anon_key

# --- Google Play review account ---
# Optional overrides. If omitted, the backend creates/reuses an isolated
# standard Supabase Auth user and derives its password from the existing
# server-only Supabase service key. Never place these values in Flutter.
GOOGLE_PLAY_REVIEW_EMAIL=
GOOGLE_PLAY_REVIEW_PASSWORD=
GOOGLE_PLAY_REVIEW_USER_ID=

# --- Klasha (covers the 120+ currencies Eversend's 10 corridors don't) ---
# Confirmed from Klasha's own docs (2026-08-25) — api.klasha.com does
# NOT resolve; this is the real production base URL.
KLASHA_BASE_URL=https://gate.klasapps.com
KLASHA_PUBLIC_KEY=your_klasha_merchant_public_key
KLASHA_SECRET_KEY=your_klasha_merchant_secret_key
# MUST be exactly 24 characters — find it on the Klasha dashboard
# under Settings -> Generate API Keys. A key of any other length will
# silently produce ciphertext Klasha's backend can't decrypt.
KLASHA_ENCRYPTION_KEY=your_24_character_key__
KLASHA_BUSINESS_ID=your_klasha_business_id

# Optional: if Klasha and/or Eversend require IP whitelisting and your
# host (e.g. Railway on a non-Pro plan) has no static outbound IP,
# point this at a static-IP proxy (e.g. Webshare, QuotaGuard Static
# IP) — format: http://user:pass@proxy-host:port. Both the Klasha and
# Eversend clients route through it; leave unset to send requests
# directly as before.
OUTBOUND_PROXY_URL=
